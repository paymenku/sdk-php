{
  "name": "paymenku/sdk-php",
  "description": "SDK PHP untuk API Paymenku",
  "type": "library",
  "license": "MIT",
  "keywords": ["paymenku", "payment", "qris", "virtual-account", "ewallet"],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Paymenku\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Paymenku\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
